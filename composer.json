{
    "name": "carloschnouda1/laravel-newsletter-subscriptions",
    "description": "Lightweight newsletter subscription package for Laravel with double opt-in confirmation and signed unsubscribe links.",
    "keywords": ["laravel", "newsletter", "subscription", "mailing-list", "double-opt-in"],
    "homepage": "https://github.com/carloschnouda1/laravel-newsletter-subscriptions",
    "license": "MIT",
    "authors": [
        {
            "name": "Carlos Chnouda"
        }
    ],
    "support": {
        "issues": "https://github.com/carloschnouda1/laravel-newsletter-subscriptions/issues",
        "source": "https://github.com/carloschnouda1/laravel-newsletter-subscriptions"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.34|^3.0",
        "pestphp/pest-plugin-laravel": "^2.3|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Carloschnouda1\\Newsletter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Carloschnouda1\\Newsletter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Carloschnouda1\\Newsletter\\NewsletterServiceProvider"
            ],
            "aliases": {
                "Newsletter": "Carloschnouda1\\Newsletter\\Facades\\Newsletter"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
